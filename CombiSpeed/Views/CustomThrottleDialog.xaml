<Window x:Class="CombiSpeed.Views.CustomThrottleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Bandwidth Throttling"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#00F0FF"
        BorderThickness="1">
    <Border Background="#0B1120" CornerRadius="16" BorderBrush="#00F0FF" BorderThickness="1" Margin="2">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00F0FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Custom Bandwidth Throttling &amp; Speed Shaper" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Dynamic cross-connection shaping for Maximum Bandwidth or Lowest Pings" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="CancelButton_Click" Style="{StaticResource CyberButton}" Padding="0" AutomationProperties.Name="Close Custom Throttling Dialog"/>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- Speed Shaper Mode & Dynamic Optimization -->
                    <TextBlock Text="DYNAMIC SPEED SHAPER OPTIMIZATION MODE" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Select Optimization Objective:" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbShaperMode" SelectionChanged="ShaperMode_SelectionChanged" Margin="0,0,0,8" AutomationProperties.Name="Optimization Objective Selector">
                                <ComboBoxItem Content="🚀 Maximum Bandwidth (Throughput &amp; Window Expansion)" Tag="MaximumBandwidth" IsSelected="True"/>
                                <ComboBoxItem Content="⚡ Lowest Latency / Ping (Anti-Bufferbloat &amp; Real-Time RTT Priority)" Tag="LowestLatency"/>
                                <ComboBoxItem Content="⚖ Balanced Dynamic (Smooth Pacing &amp; Proportional)" Tag="BalancedDynamic"/>
                            </ComboBox>
                            <TextBlock x:Name="TxtShaperModeDescription" Text="Optimizes TCP window expansion, large burst buffers (150-200ms), and dynamic cross-adapter capacity sharing for peak download/upload speeds." FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <CheckBox x:Name="ChkDynamicShaping" Content="Enable Dynamic Real-Time Shaper Adaptation across connections" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" AutomationProperties.Name="Enable Dynamic Real-Time Shaper Adaptation"/>
                            <TextBlock Text="Continuously monitors live adapter ping, throughput, and packet loss, dynamically shifting token rates and routing weights to optimize performance." FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Global Speed Caps -->
                    <TextBlock Text="GLOBAL BANDWIDTH LIMITS" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    
                    <!-- Download Limit -->
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Bonded Download Speed Cap:" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtDownloadEquiv" Text="= Unlimited" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtDownloadLimit" Text="500" Background="#131D33" Foreground="#00F0FF" BorderBrush="#334155" Padding="10,6" FontSize="13" FontWeight="Bold" FontFamily="Consolas" TextChanged="DownloadLimit_TextChanged" AutomationProperties.Name="Bonded Download Speed Cap Input"/>
                                <ComboBox x:Name="CmbDownloadUnit" Grid.Column="2" SelectionChanged="DownloadUnit_SelectionChanged" AutomationProperties.Name="Download Speed Unit Selector">
                                    <ComboBoxItem Content="Mbps" IsSelected="True"/>
                                    <ComboBoxItem Content="MB/s"/>
                                    <ComboBoxItem Content="Kbps"/>
                                    <ComboBoxItem Content="KB/s"/>
                                </ComboBox>
                            </Grid>

                            <!-- Quick Preset Chips -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Quick Caps:" FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="50 Mbps" Click="QuickCap_Click" Tag="50" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" AutomationProperties.Name="Set cap to 50 Mbps"/>
                                <Button Content="100 Mbps" Click="QuickCap_Click" Tag="100" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" AutomationProperties.Name="Set cap to 100 Mbps"/>
                                <Button Content="250 Mbps" Click="QuickCap_Click" Tag="250" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" AutomationProperties.Name="Set cap to 250 Mbps"/>
                                <Button Content="400 Mbps" Click="QuickCap_Click" Tag="400" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" AutomationProperties.Name="Set cap to 400 Mbps"/>
                                <Button Content="500 Mbps" Click="QuickCap_Click" Tag="500" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" AutomationProperties.Name="Set cap to 500 Mbps"/>
                                <Button Content="Unlimited" Click="QuickCap_Click" Tag="0" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" AutomationProperties.Name="Set cap to Unlimited"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Upload Limit -->
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Bonded Upload Speed Cap:" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtUploadEquiv" Text="= Unlimited" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtUploadLimit" Text="250" Background="#131D33" Foreground="#00F0FF" BorderBrush="#334155" Padding="10,6" FontSize="13" FontWeight="Bold" FontFamily="Consolas" TextChanged="UploadLimit_TextChanged" AutomationProperties.Name="Bonded Upload Speed Cap Input"/>
                                <ComboBox x:Name="CmbUploadUnit" Grid.Column="2" SelectionChanged="UploadUnit_SelectionChanged" AutomationProperties.Name="Upload Speed Unit Selector">
                                    <ComboBoxItem Content="Mbps" IsSelected="True"/>
                                    <ComboBoxItem Content="MB/s"/>
                                    <ComboBoxItem Content="Kbps"/>
                                    <ComboBoxItem Content="KB/s"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="ChkAutoUpload" Content="Auto-set upload cap to 50% of download rate" Foreground="#FFFFFF" FontSize="11" Checked="AutoUpload_Checked" AutomationProperties.Name="Auto-set upload cap to 50 percent"/>
                        </StackPanel>
                    </Border>

                    <!-- Throttling Policies -->
                    <TextBlock Text="THROTTLING &amp; TRAFFIC SHAPING POLICIES" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableThrottling" Content="Enable Real-Time Bandwidth &amp; Speed Throttling" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Enable Real-Time Bandwidth Throttling"/>
                            <TextBlock Text="Actively enforces token-bucket rate limiting on all HTTP, HTTPS CONNECT, SOCKS5 TCP, UDP, and Bridge streams." FontSize="11" Foreground="#CBD5E1" Margin="20,0,0,10"/>

                            <CheckBox x:Name="ChkCombineSpeeds" Content="Combine Speeds Mode (Pool aggregate bandwidth without splitting across connections)" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" AutomationProperties.Name="Combine Speeds Mode"/>
                            <TextBlock Text="Combines the throughput of all active adapters additively into a unified high-speed pool. Bandwidth is never split or partitioned into fractional slices." FontSize="11" Foreground="#CBD5E1" Margin="20,0,0,10"/>

                            <Grid Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Token Bucket Burst Tolerance Window:" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbBurstWindow" AutomationProperties.Name="Token Bucket Burst Tolerance Selector">
                                        <ComboBoxItem Content="20 ms (Ultra-Smooth Pacing - Lowest Jitter)" Tag="0.02"/>
                                        <ComboBoxItem Content="50 ms (Balanced - Recommended for Multi-WAN Bonding)" Tag="0.05" IsSelected="True"/>
                                        <ComboBoxItem Content="100 ms (High Burst - Optimized for Web Downloads)" Tag="0.10"/>
                                        <ComboBoxItem Content="250 ms (Maximum Throughput - Large TCP Buffer Window)" Tag="0.25"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Per-Adapter Custom Limits -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="PER-ADAPTER CUSTOM SPEED LIMITS (Mbps)" FontSize="11" FontWeight="Bold" Foreground="#00F0FF"/>
                        <TextBlock Text="Set 0 for Combined Pool Rate" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                        <ItemsControl x:Name="ListAdapters">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="20" Height="20" CornerRadius="4" Background="#131D33" BorderBrush="{Binding AccentHexColor}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="🌐" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding FormattedEffectivePercentage}" FontSize="11" Foreground="#CBD5E1"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding FormattedThrottledBandwidth}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontFamily="Consolas"/>

                                        <Grid Grid.Column="3">
                                            <TextBox Text="{Binding CustomSpeedLimitMbps, UpdateSourceTrigger=PropertyChanged}" Background="#131D33" Foreground="#00F0FF" BorderBrush="#334155" Padding="6,4" FontSize="11" FontFamily="Consolas" TextAlignment="Right" AutomationProperties.Name="{Binding Name, StringFormat='{}Speed Limit for {0}'}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="16,6" AutomationProperties.Name="Cancel Custom Throttling"/>
                <Button Content="Apply Parameters" Click="ApplyButton_Click" Style="{StaticResource PrimaryCyanButton}" Padding="20,6" AutomationProperties.Name="Apply Throttling Parameters"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
