<Window x:Class="CombiSpeed.Views.SpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-WAN Speed Benchmark"
        Height="540" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#F1F5F9"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E293B"
        BorderThickness="1">
    <Border Background="#0B1120" CornerRadius="16" BorderBrush="#00F0FF" BorderThickness="1" Margin="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Multi-WAN Bonding Speed Benchmark" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Measures individual adapter throughput vs aggregated bonded bandwidth" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0"/>
            </Grid>

            <!-- Progress Bar & Status -->
            <Border Grid.Row="1" Background="#080C14" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="TxtStatusMessage" Text="Ready to benchmark adapters vs combined bonded speed." FontSize="12" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBarTest" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E293B" Foreground="#00F0FF" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Results Section -->
            <Border Grid.Row="2" Background="#080C14" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultsPanel">
                        <!-- Summary Banner -->
                        <Border x:Name="BannerResult" Visibility="Collapsed" Background="#0F2D37" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="BONDED AGGREGATE SPEED" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtBondedSpeed" Text="0.00" FontSize="32" FontWeight="Black" Foreground="White" FontFamily="Consolas"/>
                                        <TextBlock Text=" Mbps" FontSize="16" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#10B981" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtBoostBadge" Text="+0% Boost" Foreground="#080C14" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBlock x:Name="TxtBondedLatency" Text="Avg Latency: 0 ms" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Individual Adapter Bars -->
                        <TextBlock Text="THROUGHPUT BREAKDOWN:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ItemsAdapterBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E2E8F0"/>
                                            <TextBlock Text="{Binding DownloadMbps, StringFormat='{}{0:F2} Mbps'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                        </Grid>
                                        <ProgressBar Height="8" Minimum="0" Maximum="200" Value="{Binding DownloadMbps}" Background="#1E293B" Foreground="#64748B" BorderThickness="0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                <Button x:Name="BtnStartTest" Content="Start Speed Test" Click="StartTest_Click" Style="{StaticResource PrimaryCyanButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
