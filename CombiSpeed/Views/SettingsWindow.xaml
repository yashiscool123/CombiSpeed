<Window x:Class="CombiSpeed.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="680" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E293B"
        BorderThickness="1">
    <Border Background="#0B1120" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Margin="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00F0FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CombiSpeed Bonding Configuration" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Network ports, load balancing algorithms, QoS shaper &amp; accessibility" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0" AutomationProperties.Name="Close Settings"/>
            </Grid>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- Port Settings -->
                    <TextBlock Text="PROXY PORTS" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HTTP / HTTPS Port:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtHttpPort" Text="8080" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="8,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="HTTP and HTTPS Proxy Port"/>
                            <TextBlock Text="Default: 8080" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SOCKS5 Port:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSocksPort" Text="1080" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="8,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="SOCKS5 Proxy Port"/>
                            <TextBlock Text="Default: 1080" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Routing Algorithm -->
                    <TextBlock Text="LOAD BALANCING ALGORITHM" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbRoutingMode" Margin="0,0,0,16" AutomationProperties.Name="Load Balancing Algorithm Selector">
                        <ComboBoxItem Content="Weighted Round-Robin (User configured ratios)" Tag="Weighted" IsSelected="True"/>
                        <ComboBoxItem Content="Equal Share (Evenly balanced across all adapters)" Tag="Equal"/>
                        <ComboBoxItem Content="Least-Latency Smart Routing (Fastest ping first)" Tag="LeastLatency"/>
                        <ComboBoxItem Content="Active-Passive Link Failover (Redundancy mode)" Tag="Failover"/>
                    </ComboBox>

                    <!-- Windows & Virtual Adapter Integration -->
                    <TextBlock Text="WINDOWS &amp; VIRTUAL ADAPTER INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutoVirtualBridge" Content="Auto-connect Virtual Bonded Bridge when CombiSpeed starts" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="Auto-connect Virtual Bonded Bridge"/>
                    <CheckBox x:Name="ChkAutoWindowsProxy" Content="Auto-enable Windows System Proxy when CombiSpeed starts" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,16" AutomationProperties.Name="Auto-enable Windows System Proxy"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Virtual Bridge Tunnel Port:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBridgePort" Text="8443" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="8,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="Virtual Bridge Tunnel Port"/>
                        <TextBlock Text="Default: 8443 (Local virtual tunnel gateway listener)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Accessibility & Display Preferences -->
                    <TextBlock Text="ACCESSIBILITY &amp; DISPLAY (WCAG 2.1 AA)" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkHighContrast" Content="Enable High Contrast Mode" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" AutomationProperties.Name="Settings High Contrast Mode Toggle"/>
                            <TextBlock Text="High luminance text &amp; vivid cyan borders for optimal visual clarity." FontSize="11" Foreground="#CBD5E1" Margin="20,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Application Scale / Text Size:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbUiScale" AutomationProperties.Name="Application UI Scale">
                                        <ComboBoxItem Content="100% (Standard Scale)" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="115% (Large Scale)" Tag="1.15"/>
                                        <ComboBoxItem Content="130% (Extra Large Scale)" Tag="1.30"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkReduceMotion" Content="Reduce Motion &amp; Animations" Foreground="#FFFFFF" FontSize="12" Margin="0,14,0,0" AutomationProperties.Name="Settings Reduce Motion Toggle"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="ChkScreenReader" Content="Optimize for Screen Readers (Narrator / NVDA / JAWS)" Foreground="#FFFFFF" FontSize="12" AutomationProperties.Name="Settings Screen Reader Toggle"/>
                        </StackPanel>
                    </Border>

                    <!-- Bandwidth Throttling & Speed Shaper -->
                    <TextBlock Text="BANDWIDTH THROTTLING &amp; SPEED SHAPER" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkEnableThrottling" Content="Enable Real-Time Bandwidth &amp; Speed Throttling" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,6" AutomationProperties.Name="Enable Real-Time Throttling"/>
                    <CheckBox x:Name="ChkCombineSpeeds" Content="Combine Speeds Mode (Pool aggregate bandwidth without splitting across connections)" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="Combine Speeds Mode"/>

                    <!-- Speed Shaper Mode & Dynamic Adaptation -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Speed Shaper Mode:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbShaperMode" AutomationProperties.Name="Speed Shaper Mode Selector">
                                <ComboBoxItem Content="🚀 Maximum Bandwidth (Throughput)" Tag="MaximumBandwidth" IsSelected="True"/>
                                <ComboBoxItem Content="⚡ Lowest Latency (Anti-Bufferbloat)" Tag="LowestLatency"/>
                                <ComboBoxItem Content="⚖ Balanced Dynamic (Proportional)" Tag="BalancedDynamic"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkDynamicShaping" Content="Enable Dynamic Real-Time Adaptation" Foreground="#FFFFFF" FontSize="12" Margin="0,14,0,0" AutomationProperties.Name="Enable Dynamic Real-Time Adaptation"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bonded Download Speed Cap:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDownloadLimit" Text="0" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="8,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="Bonded Download Speed Cap"/>
                                <ComboBox x:Name="CmbDownloadUnit" Grid.Column="2" AutomationProperties.Name="Download Speed Unit">
                                    <ComboBoxItem Content="Mbps" IsSelected="True"/>
                                    <ComboBoxItem Content="MB/s"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="0 = Unlimited (or Proportional % shaping)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bonded Upload Speed Cap:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtUploadLimit" Text="0" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="8,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="Bonded Upload Speed Cap"/>
                                <ComboBox x:Name="CmbUploadUnit" Grid.Column="2" AutomationProperties.Name="Upload Speed Unit">
                                    <ComboBoxItem Content="Mbps" IsSelected="True"/>
                                    <ComboBoxItem Content="MB/s"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="0 = Unlimited" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Burst Tolerance Window:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBurstWindow" AutomationProperties.Name="Burst Tolerance Window Selector">
                            <ComboBoxItem Content="20 ms (Ultra-Smooth Pacing - Lowest Jitter)" Tag="0.02"/>
                            <ComboBoxItem Content="50 ms (Balanced - Recommended for Multi-WAN Bonding)" Tag="0.05" IsSelected="True"/>
                            <ComboBoxItem Content="100 ms (High Burst - Optimized for Web Downloads)" Tag="0.10"/>
                            <ComboBoxItem Content="250 ms (Maximum Throughput - Large TCP Buffer Window)" Tag="0.25"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Proxy Auto-Config (PAC) & Domain Routing -->
                    <TextBlock Text="PROXY AUTO-CONFIG (PAC) DOMAIN ROUTING" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkEnablePac" Content="Enable PAC Domain Routing (AutoConfigURL)" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,6" AutomationProperties.Name="Enable PAC Domain Routing"/>
                    <TextBlock Text="Bypasses the proxy for intranet and custom domains, while aggregating the rest." FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,8"/>

                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Domain Routing Rules" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Preview PAC Script" Click="PreviewPac_Click" Style="{StaticResource CyberButton}" Padding="8,2" FontSize="10" Margin="0,0,6,0" AutomationProperties.Name="Preview Generated PAC Script"/>
                                    <Button Content="💾 Export PAC File..." Click="ExportPac_Click" Style="{StaticResource CyberButton}" Padding="8,2" FontSize="10" AutomationProperties.Name="Export PAC Script to File"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="GridPacRules" Height="130" AutoGenerateColumns="False" CanUserAddRows="True" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#131D33" Foreground="#FFFFFF">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PATTERN (DOMAIN / IP)" Binding="{Binding Pattern}" Width="160"/>
                                    <DataGridTextColumn Header="ACTION (Bonded / Direct)" Binding="{Binding Action}" Width="140"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsEnabled}" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Terminal Proxy String -->
                    <TextBlock Text="CLI PROXY STRING (CURL / GIT / NPM / DOCKER)" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
                        <Grid>
                            <TextBox x:Name="TxtCliProxy" Text="HTTP_PROXY=http://127.0.0.1:8080 HTTPS_PROXY=http://127.0.0.1:8080 ALL_PROXY=socks5://127.0.0.1:1080"
                                     IsReadOnly="True" Background="Transparent" Foreground="#00F0FF" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="CLI Proxy Environment Variables"/>
                            <Button Content="Copy" Width="50" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CopyCli_Click" Style="{StaticResource CyberButton}" Padding="0" FontSize="10" AutomationProperties.Name="Copy CLI Proxy String"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" AutomationProperties.Name="Cancel and Close Settings"/>
                <Button Content="Save Configuration" Click="SaveButton_Click" Style="{StaticResource PrimaryCyanButton}" AutomationProperties.Name="Save Configuration"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
