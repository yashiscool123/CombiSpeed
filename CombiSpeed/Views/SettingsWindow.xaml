<Window x:Class="CombiSpeed.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#F1F5F9"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E293B"
        BorderThickness="1">
    <Border Background="#0B1120" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Margin="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00F0FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CombiSpeed Bonding Configuration" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Network ports, load balancing algorithms &amp; system integration" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0"/>
            </Grid>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Port Settings -->
                    <TextBlock Text="PROXY PORTS" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HTTP / HTTPS Port:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtHttpPort" Text="8080" Background="#080C14" Foreground="White" BorderBrush="#1E293B" Padding="8,6" FontSize="12" FontFamily="Consolas"/>
                            <TextBlock Text="Default: 8080" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SOCKS5 Port:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSocksPort" Text="1080" Background="#080C14" Foreground="White" BorderBrush="#1E293B" Padding="8,6" FontSize="12" FontFamily="Consolas"/>
                            <TextBlock Text="Default: 1080" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Routing Algorithm -->
                    <TextBlock Text="LOAD BALANCING ALGORITHM" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbRoutingMode" Background="#080C14" Foreground="Black" Padding="8,6" FontSize="12" Margin="0,0,0,16">
                        <ComboBoxItem Content="Weighted Round-Robin (User configured ratios)" Tag="Weighted" IsSelected="True"/>
                        <ComboBoxItem Content="Equal Share (Evenly balanced across all adapters)" Tag="Equal"/>
                        <ComboBoxItem Content="Least-Latency Smart Routing (Fastest ping first)" Tag="LeastLatency"/>
                        <ComboBoxItem Content="Active-Passive Link Failover (Redundancy mode)" Tag="Failover"/>
                    </ComboBox>

                    <!-- Windows & Virtual Adapter Integration -->
                    <TextBlock Text="WINDOWS &amp; VIRTUAL ADAPTER INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutoVirtualBridge" Content="Auto-connect Virtual Bonded Bridge when CombiSpeed starts" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutoWindowsProxy" Content="Auto-enable Windows System Proxy when CombiSpeed starts" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Virtual Bridge Tunnel Port:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBridgePort" Text="8443" Background="#080C14" Foreground="White" BorderBrush="#1E293B" Padding="8,6" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text="Default: 8443 (Local virtual tunnel gateway listener)" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Proxy Auto-Config (PAC) & Domain Routing -->
                    <TextBlock Text="PROXY AUTO-CONFIG (PAC) DOMAIN ROUTING" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkEnablePac" Content="Enable PAC Domain Routing (AutoConfigURL)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="Bypasses the proxy for intranet and custom domains, while aggregating the rest." FontSize="10" Foreground="#64748B" Margin="0,0,0,8"/>

                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Domain Routing Rules" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                                <Button Content="Preview PAC Script" Click="PreviewPac_Click" Style="{StaticResource CyberButton}" Padding="8,2" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>

                            <DataGrid x:Name="GridPacRules" Height="130" AutoGenerateColumns="False" CanUserAddRows="True" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#131D33" Foreground="#CBD5E1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PATTERN (DOMAIN / IP)" Binding="{Binding Pattern}" Width="160"/>
                                    <DataGridTextColumn Header="ACTION (Bonded / Direct)" Binding="{Binding Action}" Width="140"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsEnabled}" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Terminal Proxy String -->
                    <TextBlock Text="CLI PROXY STRING (CURL / GIT / NPM / DOCKER)" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,8"/>
                    <Border Background="#080C14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
                        <Grid>
                            <TextBox x:Name="TxtCliProxy" Text="HTTP_PROXY=http://127.0.0.1:8080 HTTPS_PROXY=http://127.0.0.1:8080 ALL_PROXY=socks5://127.0.0.1:1080"
                                     IsReadOnly="True" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            <Button Content="Copy" Width="50" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CopyCli_Click" Style="{StaticResource CyberButton}" Padding="0" FontSize="10"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                <Button Content="Save Configuration" Click="SaveButton_Click" Style="{StaticResource PrimaryCyanButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
