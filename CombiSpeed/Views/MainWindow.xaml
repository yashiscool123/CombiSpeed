<Window x:Class="CombiSpeed.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CombiSpeed.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="840" Width="1200"
        MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#F1F5F9"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E293B"
        BorderThickness="1">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Background="#080C14" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom TitleBar -->
            <Border Grid.Row="0" Background="#060910" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" CornerRadius="12,12,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo -->
                        <Border Width="24" Height="24" CornerRadius="6" Background="#00F0FF" Margin="0,0,8,0">
                            <TextBlock Text="⚡" FontSize="14" Foreground="#080C14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="COMBISPEED" FontWeight="Black" FontSize="13" Foreground="#00F0FF" VerticalAlignment="Center"/>
                        <!-- Version Badge in Custom TitleBar -->
                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" VerticalAlignment="Center" ToolTip="Current Application Version">
                            <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        </Border>
                        <Border Width="1" Height="14" Background="#1E293B" Margin="10,0"/>

                        <!-- Engine State -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="DISCONNECTED"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Text" Value="BONDING ENGINE ACTIVE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- System Proxy Tag -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                Visibility="{Binding IsWindowsProxyActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="SYS PROXY ON" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>

                        <!-- Virtual Bridge Tag -->
                        <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                Visibility="{Binding VirtualBridge.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="BRIDGE BONDED" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="28" Height="24" Click="MinimizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0"/>
                        <Button Content="▢" Width="28" Height="24" Click="MaximizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0"/>
                        <Button Content="✕" Width="28" Height="24" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- Master Control Card -->
                    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Big Power Button -->
                            <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Width="74" Height="74" Margin="0,0,20,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                                        <TextBlock x:Name="btnIcon" Text="⏻" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#00F0FF"/>
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="btnIcon" Property="Foreground" Value="#080C14"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Status Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="MULTI-WAN CHANNEL BONDING" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{Binding Config.RoutingMode, StringFormat='{}Mode: {0}'}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="20" FontWeight="Black" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Aggregation Engine Idle"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                    <Setter Property="Text" Value="Bandwidth Aggregation Active"/>
                                                    <Setter Property="Foreground" Value="#00F0FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Combines all active physical network adapters into a unified accelerated bandwidth pipeline." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Windows System Proxy Toggle -->
                                <Button Command="{Binding ToggleWindowsProxyCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding IsWindowsProxyActive, StringFormat='{}Win Proxy: {0}'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Win Proxy: OFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWindowsProxyActive}" Value="True">
                                                            <Setter Property="Text" Value="Win Proxy: ON"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Content="Benchmark Speed" Click="OpenSpeedTest_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                                <Button Content="⟳" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource CyberButton}" ToolTip="Rescan Adapters" Margin="0,0,8,0"/>
                                <Button Content="⚙" Click="OpenSettings_Click" Style="{StaticResource CyberButton}" ToolTip="Configuration"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Virtual VPN / Adapter Connection / Bonded Bridge Card -->
                    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header row -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="🌉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="VIRTUAL BONDED BRIDGE &amp; ADAPTER CONNECTION" FontSize="12" FontWeight="Black" Foreground="#00F0FF"/>
                                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" Background="{Binding VirtualBridge.StatusBrush}">
                                                <TextBlock Text="{Binding VirtualBridge.StatusText}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Unified Windows virtual network adapter merging physical interfaces proportional to their allocated % bandwidth." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding ToggleVirtualBridgeCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding VirtualBridge.IsConnected, StringFormat='{}Bridge: {0}'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Connect Bridge"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VirtualBridge.IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="Disconnect Bridge"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="View in Windows (ncpa.cpl)" Command="{Binding OpenNetworkConnectionsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" ToolTip="Inspect adapter in Windows Network Connections"/>
                                    <Button Content="⟳ Re-provision" Command="{Binding ReprovisionBridgeCommand}" Style="{StaticResource CyberButton}" ToolTip="Re-create Windows connection profile"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bridge Metadata Grid -->
                            <Border Background="#080C14" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WINDOWS CONNECTION NAME" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding VirtualBridge.ConnectionName}" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VIRTUAL IP" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding VirtualBridge.VirtualIp}" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="GATEWAY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding VirtualBridge.GatewayIp}" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="BRIDGE THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding VirtualBridge.FormattedDownloadSpeed, StringFormat='{}↓ {0}'}" FontSize="13" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Merged Member Adapters & Bandwidth Breakdown -->
                            <Border Background="#131D33" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="MERGED PHYSICAL ADAPTERS &amp; BANDWIDTH ALLOCATION %" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                                        <TextBlock Text="{Binding VirtualBridge.MergedAdaptersSummary}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Segmented Multi-Color Bandwidth Distribution Bar -->
                                    <Border Height="14" CornerRadius="6" Background="#080C14" ClipToBounds="True">
                                        <ItemsControl ItemsSource="{Binding Adapters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Height="14" Width="{Binding EffectivePercentageWidth}" Fill="{Binding AccentHexColor}" ToolTip="{Binding FormattedEffectivePercentage}" Margin="0,0,2,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Telemetry 4-Card Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download Speed -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="BONDED DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding BondedDownloadSpeed}" FontSize="24" FontWeight="Black" Foreground="#00F0FF" FontFamily="Consolas" Margin="0,4,0,0"/>
                                <TextBlock Text="Real-time aggregated bandwidth" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Upload Speed -->
                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="BONDED UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding BondedUploadSpeed}" FontSize="24" FontWeight="Black" Foreground="#8B5CF6" FontFamily="Consolas" Margin="0,4,0,0"/>
                                <TextBlock Text="Outbound throughput across NICs" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Concurrency -->
                        <Border Grid.Column="4" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE CONCURRENCY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ActiveStreamsCount}" FontSize="24" FontWeight="Black" Foreground="#10B981" FontFamily="Consolas"/>
                                    <TextBlock Text=" streams" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalStreamsCount, StringFormat='{}Total Dispatched: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Session Volume & Uptime -->
                        <Border Grid.Column="6" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="SESSION VOLUME &amp; UPTIME" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SessionVolume}" FontSize="24" FontWeight="Black" Foreground="#F59E0B" FontFamily="Consolas" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Uptime, StringFormat='{}Uptime: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Real-Time Bandwidth Waveform -->
                    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="REAL-TIME BANDWIDTH WAVEFORM" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" (Last 60 Seconds)" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="#00F0FF" Margin="0,0,4,0"/>
                                    <TextBlock Text="Download" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,4,0"/>
                                    <TextBlock Text="Upload" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding PeakSpeedFormatted}" FontSize="11" Foreground="#00F0FF" FontFamily="Consolas"/>
                                </StackPanel>
                            </Grid>

                            <!-- Waveform Canvas -->
                            <Border Background="#080C14" CornerRadius="10" Height="140" ClipToBounds="True">
                                <Grid>
                                    <Polyline Points="{Binding WaveformPointsDownload}" Stroke="#00F0FF" StrokeThickness="2"/>
                                    <Polyline Points="{Binding WaveformPointsUpload}" Stroke="#8B5CF6" StrokeThickness="1.5"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Active Adapters Section -->
                    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header with Profile Selection, Save Combination & Auto-Save Badge -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ADAPTER COMBINATIONS &amp; ALLOCATION" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                    <Border Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AutoSaveStatusText}" FontSize="10" Foreground="#34D399" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Profile:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding ActiveProfileName}" Width="160" Height="26" Margin="0,0,8,0" FontSize="11" Background="#080C14" Foreground="Black" VerticalAlignment="Center"/>
                                    <Button Content="💾 Save" Command="{Binding SaveCurrentSettingsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,2" FontSize="10" ToolTip="Persist current adapter combination &amp; weights to disk"/>
                                    <Button Content="+ New Profile" Click="NewProfile_Click" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,2" FontSize="10" ToolTip="Save current settings under a new profile name"/>
                                    <Button Content="✕" Command="{Binding DeleteProfileCommand}" Style="{StaticResource CyberButton}" Padding="6,2" FontSize="10" ToolTip="Delete selected profile (Default Combination cannot be deleted)"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bandwidth Throttling & Speed Shaper Toolbar -->
                            <Border Background="#080C14" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ SPEED SHAPER:" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="#131D33" CornerRadius="4" Padding="6,2" BorderBrush="#00F0FF" BorderThickness="0.5">
                                            <TextBlock Text="{Binding ThrottleStatusText}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Mode:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox ItemsSource="{Binding ShaperModes}" SelectedItem="{Binding SelectedShaperMode}" Width="160" Height="24" FontSize="10" Background="#080C14" Foreground="Black" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Select Speed Shaper Mode: Maximum Bandwidth (Throughput) or Lowest Latency (Gaming/VoIP pings)"/>

                                        <TextBlock Text="Cap:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox ItemsSource="{Binding ThrottlePresets}" SelectedItem="{Binding SelectedThrottlePreset}" Width="160" Height="24" FontSize="10" Background="#080C14" Foreground="Black" VerticalAlignment="Center" ToolTip="Set Speed Throttle Cap (up to 500 Mbps or Custom)"/>

                                        <Button Content="⚙ Custom..." Click="CustomThrottle_Click" Style="{StaticResource CyberButton}" Margin="6,0,0,0" Padding="8,2" FontSize="10" ToolTip="Configure custom speed limits up to 500+ Mbps, burst window &amp; per-adapter caps"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#131D33" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="4">
                                            <StackPanel>
                                                <!-- Top: Name, Status, Toggle -->
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" Height="26" Background="{Binding AccentHexColor}" CornerRadius="2" Margin="0,0,8,0"/>
                                                        <TextBlock Text="🖧" FontSize="16" Foreground="{Binding AccentHexColor}" Margin="0,0,8,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="#080C14" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PingMs, StringFormat='{}{0} ms'}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding PingMs, Converter={StaticResource PingToBrushConverter}}"/>
                                                        </Border>
                                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- IP & MAC -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="BOUND LOCAL IP" FontSize="9" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Address}" FontSize="12" FontFamily="Consolas" Foreground="#CBD5E1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PUBLIC WAN IP" FontSize="9" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding WanIp}" FontSize="12" FontFamily="Consolas" Foreground="#00F0FF"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Live Speeds -->
                                                <Border Background="#080C14" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="↓ " Foreground="#00F0FF" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding FormattedDownloadSpeed}" FontSize="12" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="↑ " Foreground="#8B5CF6" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding FormattedUploadSpeed}" FontSize="12" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Weight Ratio Slider & Effective Utilization % -->
                                                <Grid Margin="0,0,0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="BANDWIDTH: " FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding FormattedEffectivePercentage}" FontSize="10" FontWeight="Bold" Foreground="{Binding AccentHexColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormattedThrottledBandwidth}" FontSize="9" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,8,0" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding Weight, StringFormat='{}Weight: {0}%'}" FontSize="10" Foreground="#64748B" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Weight}" SmallChange="5" LargeChange="10" Margin="0,2,0,0" IsEnabled="{Binding IsEnabled}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Connection Audit Stream -->
                    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="CONNECTION AUDIT STREAM" FontSize="11" FontWeight="Bold" Foreground="#00F0FF"/>
                                <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" Style="{StaticResource CyberButton}" HorizontalAlignment="Right" Padding="8,2" FontSize="10"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" Background="#080C14" BorderBrush="#1E293B" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0B1120" Foreground="#CBD5E1" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="70"/>
                                    <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="90"/>
                                    <DataGridTextColumn Header="TARGET DESTINATION" Binding="{Binding DestinationFormatted}" Width="*"/>
                                    <DataGridTextColumn Header="DISPATCHED ADAPTER" Binding="{Binding AdapterName}" Width="160"/>
                                    <DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeFormatted}" Width="80"/>
                                    <DataGridTextColumn Header="DURATION" Binding="{Binding DurationMs, StringFormat='{}{0}ms'}" Width="80"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Pinned Cyberpunk Glass Footer Status Bar -->
            <Border Grid.Row="2" Background="#060910" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ COMBISPEED" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#334155"/>
                        <Border Padding="5,1" CornerRadius="3" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" Margin="0,0,8,0" ToolTip="Installed Release Version &amp; Build Code">
                            <TextBlock Text="{Binding AppVersionFull}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text="Multi-WAN Channel Bonding &amp; Bandwidth Aggregation Engine" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutoSaveStatusText, StringFormat='{}Auto-Sync: {0}'}" FontSize="10" Foreground="#94A3B8" Margin="0,0,16,0"/>
                        <TextBlock Text="Windows x64 (.NET 8.0)" FontSize="10" Foreground="#475569" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
