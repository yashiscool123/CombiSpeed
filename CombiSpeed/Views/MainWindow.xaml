<Window x:Class="CombiSpeed.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CombiSpeed.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="860" Width="1220"
        MinWidth="1060" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CyberBg}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{DynamicResource CyberBorder}"
        BorderThickness="1">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding TogglePowerCommand}"/>
        <KeyBinding Gesture="Alt+P" Command="{Binding TogglePowerCommand}"/>
        <KeyBinding Gesture="Alt+B" Command="{Binding ToggleVirtualBridgeCommand}"/>
        <KeyBinding Gesture="Alt+W" Command="{Binding ToggleWindowsProxyCommand}"/>
        <KeyBinding Gesture="Alt+R" Command="{Binding RefreshAdaptersCommand}"/>
        <KeyBinding Gesture="Alt+H" Command="{Binding ToggleHighContrastCommand}"/>
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Gesture="Ctrl+NumPad2" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Gesture="Ctrl+NumPad3" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Gesture="Ctrl+NumPad4" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Gesture="Ctrl+NumPad5" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
    </Window.InputBindings>

    <Border Background="{DynamicResource CyberBg}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1">
        <Grid>
            <!-- Accessible Dynamic UI Layout Transform -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </Grid.LayoutTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Custom Accessible TitleBar -->
            <Border Grid.Row="0" Background="#060910" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" CornerRadius="12,12,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Neon Brand Logo -->
                        <Border Width="26" Height="26" CornerRadius="7" Background="#00F0FF" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="15" Foreground="#040810" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="COMBISPEED" FontWeight="Black" FontSize="14" Foreground="#00F0FF" VerticalAlignment="Center"/>

                        <!-- Version Badge -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" VerticalAlignment="Center" ToolTip="Installed Release Version &amp; Build Code">
                            <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        </Border>
                        <Border Width="1" Height="14" Background="#1E293B" Margin="10,0"/>

                        <!-- Engine State Indicator with Icon & Accessible Color -->
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="DISCONNECTED"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Text" Value="BONDING ACTIVE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- System Proxy Tag -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                ToolTip="Windows System Proxy is active on 127.0.0.1:8080"
                                Visibility="{Binding IsWindowsProxyActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="🛡️ SYS PROXY ON" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>

                        <!-- Virtual Bridge Tag -->
                        <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                ToolTip="Virtual Network Bridge adapter is bonded and routing packets across physical NICs"
                                Visibility="{Binding VirtualBridge.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="🌉 BRIDGE BONDED" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>

                        <!-- High Contrast Tag -->
                        <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#1E293B" BorderBrush="#00F0FF" BorderThickness="0.5"
                                ToolTip="High Contrast accessible color palette is active"
                                Visibility="{Binding IsHighContrast, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="♿ HC: ON" FontSize="9" FontWeight="Bold" Foreground="#00F0FF"/>
                        </Border>
                    </StackPanel>

                    <!-- TitleBar Action Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Theme Switcher (Dark / Light) -->
                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="8,4" FontSize="11" ToolTip="Toggle between Dark Cyberpunk and Soothing Light Themes (WCAG 2.1 AA/AAA compliant)" AutomationProperties.Name="Toggle Light and Dark Theme">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ThemeToggleText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Accessibility Button -->
                        <Button Click="OpenAccessibility_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" ToolTip="Configure accessibility features, UI scaling, screen reader settings, and view keyboard shortcuts (Alt+A)" AutomationProperties.Name="Open Accessibility Options">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♿" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Accessibility" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Content="⚙" Click="OpenSettings_Click" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Padding="8,4" FontSize="12" ToolTip="Open application settings, port bindings, default timeouts, and logging configuration (Alt+S)" AutomationProperties.Name="Open Settings"/>

                        <!-- Window Control Buttons -->
                        <Button Content="—" Width="30" Height="26" Click="MinimizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0" ToolTip="Minimize window to taskbar" AutomationProperties.Name="Minimize Window"/>
                        <Button Content="▢" Width="30" Height="26" Click="MaximizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0" ToolTip="Maximize or restore window size" AutomationProperties.Name="Maximize Window"/>
                        <Button Content="✕" Width="30" Height="26" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0" ToolTip="Close CombiSpeed application" AutomationProperties.Name="Close Window"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Native TabControl with Custom Segmented Navigation Style -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Style="{StaticResource SegmentedTabControl}">
                <!-- ========================================== -->
                <!-- TAB 0: OVERVIEW & DASHBOARD                -->
                <!-- ========================================== -->
                <TabItem Header="⚡ Overview &amp; Dashboard" Style="{StaticResource SegmentedTabItem}" ToolTip="Real-time multi-WAN bonding dashboard, throughput monitors, network identity, and virtual bridge status (Ctrl+1)" AutomationProperties.Name="Overview and Dashboard Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Master Hero Control Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big Power Switch -->
                                    <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Width="78" Height="78" Margin="0,0,22,0" Cursor="Hand" ToolTip="Toggle Master Multi-WAN Bonding (Space / Alt+P)" AutomationProperties.Name="Master Bonding Power Button">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                                <TextBlock x:Name="btnIcon" Text="⏻" FontSize="36" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#00F0FF"/>
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter TargetName="btnIcon" Property="Foreground" Value="#040810"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00F0FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Status Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="MULTI-WAN CHANNEL BONDING ENGINE" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{Binding Config.RoutingMode, StringFormat='{}Mode: {0}'}" FontSize="10" Foreground="#CBD5E1" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aggregation Engine Idle"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                            <Setter Property="Text" Value="Bandwidth Aggregation Active"/>
                                                            <Setter Property="Foreground" Value="#00F0FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Multiplexes concurrent TCP &amp; UDP connections across all enabled physical interfaces into a unified super-pipe." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Hero Action Bar -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Windows System Proxy Toggle -->
                                        <Button Command="{Binding ToggleWindowsProxyCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" ToolTip="Windows System Proxy: Automatically registers 127.0.0.1:8080 in WinINet so browsers and desktop applications route through the bonded channel (Alt+W)" AutomationProperties.Name="Toggle Windows System Proxy">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🛡" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding IsWindowsProxyActive, StringFormat='{}Win Proxy: {0}'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Win Proxy: OFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWindowsProxyActive}" Value="True">
                                                                    <Setter Property="Text" Value="Win Proxy: ON"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Virtual Bridge Toggle -->
                                        <Button Command="{Binding ToggleVirtualBridgeCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" ToolTip="Virtual Bonded Bridge: Activates the virtual network adapter bridge merging all physical NICs with proportional bandwidth allocation for zero-configuration application support (Alt+B)" AutomationProperties.Name="Toggle Virtual Bonded Bridge">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌉" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding VirtualBridge.IsConnected, StringFormat='{}Bridge: {0}'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Bridge: OFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VirtualBridge.IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="Bridge: ON"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <Button Content="📊 Benchmark Speed" Click="OpenSpeedTest_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" ToolTip="Speed Benchmark: Run an integrated multi-threaded upload, download, and latency test measuring true aggregated bonding performance" AutomationProperties.Name="Open Speed Benchmark"/>
                                        <Button Content="⟳" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource CyberButton}" ToolTip="Rescan Network Adapters: Re-probes all connected physical Ethernet, Wi-Fi, USB cellular, and hotspot interfaces (Alt+R)" AutomationProperties.Name="Rescan Adapters"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Intranet & Internet Geo-Location Identity Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Flag Icon Box -->
                                    <Border Grid.Column="0" Width="48" Height="48" Background="#1E293B" CornerRadius="12" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentFlagEmoji}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="NETWORK IDENTITY &amp; LIVE GEO-LOCATION" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#10B981" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="LIVE GEOIP" FontSize="9" FontWeight="Bold" Foreground="#040810"/>
                                            </Border>
                                        </StackPanel>

                                        <WrapPanel Orientation="Horizontal">
                                            <!-- Location & Country -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,3">
                                                <TextBlock Text="Location: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding CurrentLocation}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </StackPanel>

                                            <!-- Internet WAN IP -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,3">
                                                <TextBlock Text="Internet WAN IP: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding CurrentInternetIp}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <!-- Intranet Local IP -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,3">
                                                <TextBlock Text="Intranet IP: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding CurrentIntranetIp}" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <!-- ISP -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="ISP: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding CurrentIsp}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Refresh Action -->
                                    <Button Grid.Column="2" Command="{Binding RefreshGeoIpCommand}" Style="{StaticResource CyberButton}" Content="⟳ Refresh Identity" VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,8" ToolTip="Re-query Intranet and Internet Geo-Location Identity: Probes GeoIP services to detect latest public IP, city, country, and ISP changes"/>
                                </Grid>
                            </Border>

                            <!-- Telemetry 4-Card Grid (High-Contrast Large Typography) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed Card -->
                                <Border Grid.Column="0" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" ToolTip="Real-time aggregated incoming bandwidth across all active physical network adapters">
                                    <StackPanel>
                                        <TextBlock Text="BONDED DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding BondedDownloadSpeed}" FontSize="26" FontWeight="Black" Foreground="#00F0FF" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="Real-time aggregated bandwidth" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Upload Speed Card -->
                                <Border Grid.Column="2" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" ToolTip="Real-time aggregated outbound transmission bandwidth across all active physical network adapters">
                                    <StackPanel>
                                        <TextBlock Text="BONDED UPLOAD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding BondedUploadSpeed}" FontSize="26" FontWeight="Black" Foreground="#8B5CF6" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="Outbound throughput across NICs" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Concurrency Card -->
                                <Border Grid.Column="4" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" ToolTip="Active simultaneous network streams currently multiplexed across the load balancer">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE CONCURRENCY" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ActiveStreamsCount}" FontSize="26" FontWeight="Black" Foreground="#10B981" FontFamily="Consolas"/>
                                            <TextBlock Text=" streams" FontSize="13" Foreground="#F1F5F9" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalStreamsCount, StringFormat='{}Total Dispatched: {0}'}" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Volume & Uptime Card -->
                                <Border Grid.Column="6" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" ToolTip="Total data transferred (upload + download) and engine uptime since bonding was activated">
                                    <StackPanel>
                                        <TextBlock Text="SESSION VOLUME &amp; UPTIME" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding SessionVolume}" FontSize="26" FontWeight="Black" Foreground="#F59E0B" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Uptime, StringFormat='{}Uptime: {0}'}" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Virtual Bonded Bridge Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,16" ToolTip="Virtual Network Bridge merging physical NICs into a unified Windows virtual adapter">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,10,0">
                                                <TextBlock Text="🌉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="VIRTUAL BONDED BRIDGE &amp; ADAPTER CONNECTION" FontSize="12" FontWeight="Black" Foreground="#00F0FF"/>
                                                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" Background="{Binding VirtualBridge.StatusBrush}">
                                                        <TextBlock Text="{Binding VirtualBridge.StatusText}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Native Windows virtual adapter merging physical NICs based on user % allocation." FontSize="11" Foreground="#F1F5F9" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="View in Windows (ncpa.cpl)" Command="{Binding OpenNetworkConnectionsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" ToolTip="Open Windows Network Connections (ncpa.cpl) to view and manage physical and virtual network adapters" AutomationProperties.Name="Open Network Connections in Windows"/>
                                            <Button Content="⟳ Re-provision" Command="{Binding ReprovisionBridgeCommand}" Style="{StaticResource CyberButton}" ToolTip="Re-provision Virtual Bridge: Re-creates and re-initializes the virtual network bridge adapter with fresh routing table entries" AutomationProperties.Name="Reprovision Virtual Bridge"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Metadata Strip -->
                                    <Border Background="#080C14" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="WINDOWS CONNECTION NAME" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.ConnectionName}" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="VIRTUAL IP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.VirtualIp}" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="GATEWAY" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.GatewayIp}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="BRIDGE THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.FormattedDownloadSpeed, StringFormat='{}↓ {0}'}" FontSize="13" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Segmented Distribution Bar -->
                                    <Border Background="{DynamicResource CyberCard}" CornerRadius="10" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="MERGED PHYSICAL ADAPTERS &amp; BANDWIDTH ALLOCATION %" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                                                <TextBlock Text="{Binding VirtualBridge.MergedAdaptersSummary}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                            </Grid>

                                            <Border Height="14" CornerRadius="6" Background="#080C14" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding Adapters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Height="14" Width="{Binding EffectivePercentageWidth}" Fill="{Binding AccentHexColor}" ToolTip="{Binding FormattedEffectivePercentage}" Margin="0,0,2,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Real-Time Bandwidth Waveform -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="REAL-TIME BANDWIDTH WAVEFORM" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text=" (Last 60 Seconds)" FontSize="11" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="8" Height="8" Fill="#00F0FF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Download" FontSize="11" Foreground="#F1F5F9" Margin="0,0,12,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,4,0"/>
                                            <TextBlock Text="Upload" FontSize="11" Foreground="#F1F5F9" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding PeakSpeedFormatted}" FontSize="11" Foreground="#00F0FF" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#080C14" CornerRadius="10" Height="140" ClipToBounds="True">
                                        <Grid>
                                            <Polyline Points="{Binding WaveformPointsDownload}" Stroke="#00F0FF" StrokeThickness="2"/>
                                            <Polyline Points="{Binding WaveformPointsUpload}" Stroke="#8B5CF6" StrokeThickness="1.5"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 1: COMBINED ADAPTERS & ALLOCATION      -->
                <!-- ========================================== -->
                <TabItem Header="🖧 Combined Adapters" Style="{StaticResource SegmentedTabItem}" ToolTip="Manage network adapters, toggle interfaces, assign bandwidth share weights, and manage profiles (Ctrl+2)" AutomationProperties.Name="Combined Adapters Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Profiles Header Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="COMBINATION PROFILES &amp; ADAPTER ALLOCATION" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                        <Border Width="1" Height="18" Background="{DynamicResource CyberBorder}" Margin="12,0,12,0"/>
                                        <Button Content="⟳ Rescan Adapters" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" ToolTip="Scan and detect all active physical, Wi-Fi, Ethernet, Cellular &amp; bridge network adapters (Alt+R)" AutomationProperties.Name="Rescan All Combinable Adapters"/>
                                        <Border Background="#080C14" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CombinableAdaptersCountText}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Profile:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding ActiveProfileName}" Width="200" Height="32" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center" ToolTip="Switch between saved adapter combination configurations and allocation presets" AutomationProperties.Name="Active Combination Profile Selector"/>
                                        <Button Content="💾 Save" Command="{Binding SaveCurrentSettingsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Persist current adapter combination &amp; weights to active profile" AutomationProperties.Name="Save Combination Settings"/>
                                        <Button Content="+ New Profile" Click="NewProfile_Click" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Save current settings under a new custom profile name" AutomationProperties.Name="Create New Profile"/>
                                        <Button Content="✕" Command="{Binding DeleteProfileCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" ToolTip="Delete selected profile from disk" AutomationProperties.Name="Delete Active Profile"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Empty State if no adapters detected -->
                            <Border Visibility="{Binding HasNoAdapters, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource CyberSurface}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}"
                                    BorderThickness="1" Padding="40,30" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="No Combinable Network Adapters Found" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Connect your Wi-Fi, Ethernet, 4G/5G Cellular USB dongle, or mobile hotspot, then click Rescan." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <Button Content="⟳ Rescan All Adapters" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource CyberButton}" Padding="16,8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Rescan Network Adapters (Alt+R)" AutomationProperties.Name="Rescan All Adapters Empty State Button"/>
                                </StackPanel>
                            </Border>

                            <!-- Adapters Grid (2-Column Responsive Card Grid) -->
                            <ItemsControl ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CyberSurface}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="6">
                                            <StackPanel>
                                                <!-- Top: Name, Status, Toggle -->
                                                <Grid Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" Height="28" Background="{Binding AccentHexColor}" CornerRadius="2" Margin="0,0,10,0"/>
                                                        <TextBlock Text="🖧" FontSize="18" Foreground="{Binding AccentHexColor}" Margin="0,0,8,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#F1F5F9" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="#080C14" CornerRadius="10" Padding="8,3" Margin="0,0,10,0" ToolTip="Round-trip gateway and DNS ping latency for this adapter">
                                                            <TextBlock Text="{Binding PingMs, StringFormat='{}{0} ms'}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding PingMs, Converter={StaticResource PingToBrushConverter}}"/>
                                                        </Border>
                                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" ToolTip="Enable or disable this network adapter in the aggregated bonding pool" AutomationProperties.Name="{Binding Name, StringFormat='{}Enable {0}'}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- IP & MAC -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="BOUND LOCAL IP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding Address}" FontSize="12" FontFamily="Consolas" Foreground="#FFFFFF" ToolTip="Local interface IP address used for socket binding"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PUBLIC WAN &amp; LOCATION" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding FormattedLocation}" FontSize="11" FontFamily="Consolas" Foreground="#00F0FF" TextTrimming="CharacterEllipsis" ToolTip="{Binding FormattedLocation}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Live Speeds -->
                                                <Border Background="#080C14" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" ToolTip="Current download and upload throughput passing through this interface">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="↓ " Foreground="#00F0FF" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding FormattedDownloadSpeed}" FontSize="13" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="↑ " Foreground="#8B5CF6" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding FormattedUploadSpeed}" FontSize="13" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Weight Ratio Slider & Effective Utilization % -->
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="BANDWIDTH SHARE: " FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding FormattedEffectivePercentage}" FontSize="11" FontWeight="Bold" Foreground="{Binding AccentHexColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormattedThrottledBandwidth}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,8,0" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding Weight, StringFormat='{}Weight: {0}%'}" FontSize="11" Foreground="#F1F5F9" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Weight}" SmallChange="5" LargeChange="10" Margin="0,4,0,0" IsEnabled="{Binding IsEnabled}" ToolTip="Adjust bandwidth allocation weight (0-100%) for this network adapter" AutomationProperties.Name="{Binding Name, StringFormat='{}Bandwidth Weight for {0}'}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 2: SPEED SHAPER & QOS                  -->
                <!-- ========================================== -->
                <TabItem Header="🚀 Speed Shaper &amp; QoS" Style="{StaticResource SegmentedTabItem}" ToolTip="Configure dynamic speed shaping, Token Bucket QoS algorithms, bandwidth throttling limits, and anti-bufferbloat (Ctrl+3)" AutomationProperties.Name="Speed Shaper and QoS Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Speed Shaper Banner -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="⚡ DYNAMIC SPEED SHAPER &amp; QOS CONTROL" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#131D33" CornerRadius="4" Padding="6,2" BorderBrush="#00F0FF" BorderThickness="0.5" ToolTip="Active Token Bucket throttling and dynamic speed cap status">
                                                <TextBlock Text="{Binding ThrottleStatusText}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Actively shapes packet flows, adjusts Token Bucket capacities in real time as link telemetry fluctuates, and eliminates bufferbloat for gaming &amp; streaming." FontSize="12" Foreground="#F1F5F9" Margin="0,0,0,12"/>

                                        <!-- Mode Selector Grid -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Optimization Mode:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ShaperModes}" SelectedItem="{Binding SelectedShaperMode}" Height="34" FontSize="11" ToolTip="Select traffic shaping algorithm: Maximum Bandwidth (highest throughput), Lowest Latency (gaming &amp; voice calls), Balanced QoS, Streaming Optimized, or Gaming Priority" AutomationProperties.Name="Speed Shaper Optimization Mode"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Global Bandwidth Cap:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ThrottlePresets}" SelectedItem="{Binding SelectedThrottlePreset}" Height="34" FontSize="11" ToolTip="Select an overall download and upload speed limit across all combined interfaces, or choose Unlimited" AutomationProperties.Name="Global Speed Throttle Cap Preset"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Actions -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⚙ Custom Throttling Parameters (Mbps / Burst / Per-NIC)..." Click="CustomThrottle_Click" Style="{StaticResource PrimaryCyanButton}" Margin="0,0,10,0" ToolTip="Open advanced QoS parameters: configure precise Mbps upload/download limits, Token Bucket burst sizes (ms), and per-NIC bandwidth caps" AutomationProperties.Name="Open Custom Throttling Dialog"/>
                                            <CheckBox IsChecked="{Binding Config.EnableDynamicShaping}" Content="Enable Real-Time Dynamic Adaptation across connections" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Enable Real-Time Dynamic Adaptation: automatically redistributes traffic when an adapter experiences packet drops or latency spikes" AutomationProperties.Name="Enable Dynamic Adaptation"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- QoS Mode Feature Comparison Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="SPEED SHAPER OPTIMIZATION OBJECTIVES" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Max Bandwidth Mode Box -->
                                        <Border Grid.Column="0" Background="#080C14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="🚀 MAXIMUM BANDWIDTH MODE" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Large Token Bucket burst buffers (150ms-250ms) for full TCP window expansion." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Dynamic cross-connection borrowing: surging streams borrow unused capacity." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Throughput-weighted dispatching prioritizing high-capacity lines." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Lowest Latency Mode Box -->
                                        <Border Grid.Column="2" Background="#080C14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="⚡ LOWEST LATENCY / PING MODE" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Anti-bufferbloat pacing (clamped to 20ms burst window) eliminates queue latency." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Inverse-ping token weighting (1000 / PingMs) funnels packets to fastest line." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Optimized for Valorant, CS2, CoD, Discord voice &amp; WebRTC calls." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 3: CONNECTION AUDIT                    -->
                <!-- ========================================== -->
                <TabItem Header="📜 Connection Audit" Style="{StaticResource SegmentedTabItem}" ToolTip="Inspect live network socket requests, dispatched adapters, byte volumes, and transfer latency (Ctrl+4)" AutomationProperties.Name="Connection Audit Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="CONNECTION AUDIT STREAM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CyberCyan}"/>
                                            <TextBlock Text=" (Live Network Requests, Proxy Routing &amp; Physical NIC Telemetry)" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox Content="Enable Connection Audit Logging" IsChecked="{Binding EnableAuditLogging}" Style="{StaticResource CyberCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Toggle live connection audit event recording to optimize memory and CPU performance" AutomationProperties.Name="Toggle Connection Audit Logging"/>
                                            <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" Style="{StaticResource CyberButton}" Padding="12,4" FontSize="11" ToolTip="Clear all recorded connection audit events from the table" AutomationProperties.Name="Clear Connection Audit Logs"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Height="480" Background="{DynamicResource CyberBg}" BorderBrush="{DynamicResource CyberBorder}" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource CyberCard}" Foreground="{DynamicResource TextPrimary}" HeadersVisibility="Column" ToolTip="Historical log of outbound socket connections, showing protocol, target destination, selected proxy server, connection result, latency, resolved IP, selected physical adapter, transferred bytes, and duration" AutomationProperties.Name="Connection Audit Logs Table">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="75"/>
                                            <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="85"/>
                                            <DataGridTextColumn Header="TARGET DESTINATION" Binding="{Binding DestinationFormatted}" Width="*"/>
                                            <DataGridTextColumn Header="PROXY SERVER" Binding="{Binding ProxyDisplay}" Width="150"/>
                                            <DataGridTextColumn Header="RESULT" Binding="{Binding ResultFormatted}" Width="75"/>
                                            <DataGridTextColumn Header="LATENCY" Binding="{Binding LatencyDisplay}" Width="75"/>
                                            <DataGridTextColumn Header="RESOLVED IP" Binding="{Binding ResolvedIpDisplay}" Width="110"/>
                                            <DataGridTextColumn Header="DISPATCHED ADAPTER" Binding="{Binding AdapterName}" Width="140"/>
                                            <DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeFormatted}" Width="80"/>
                                            <DataGridTextColumn Header="DURATION" Binding="{Binding DurationMs, StringFormat='{}{0}ms'}" Width="75"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 4: ROTATING PROXY & HARVESTER          -->
                <!-- ========================================== -->
                <TabItem Header="🔄 Rotating Proxy &amp; Harvester" Style="{StaticResource SegmentedTabItem}" ToolTip="Automated rotating proxy server, proxy scraper/harvester, health validator, and multi-NIC rotation dispatch (Ctrl+5)" AutomationProperties.Name="Rotating Proxy and Harvester Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Rotating Proxy Hero Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="AUTOMATED ROTATING PROXY HARVESTER &amp; DISPATCHER" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1" ToolTip="Local listening port for client applications">
                                                <TextBlock Text="{Binding RotatingProxyPort, StringFormat='{}Port: {0}'}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Double-Layer Multi-NIC Egress &amp; Open-Source Harvester" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Harvests live proxies from curated open-source feeds &amp; custom URLs, validates health &amp; anonymity, and rotates upstream requests across local physical network adapters." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding IsRotatingProxyRunning, Converter={StaticResource BoolToRotatorStatusConverter}}" Command="{Binding ToggleRotatingProxyCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,8" FontWeight="Bold" ToolTip="Start or stop the local Rotating Proxy HTTP/SOCKS5 server on port 8081"/>
                                        <Button Content="⚡ Harvest Proxies" Command="{Binding HarvestProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,8" FontWeight="Bold" ToolTip="Fetch latest public proxy lists from configured GitHub, API, and URL sources in idempotence mode"/>
                                        <Button Content="🔍 Validate Pool" Command="{Binding ValidatePoolCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="12,8" ToolTip="Test all harvested proxies for connectivity, protocol compatibility, response time, and anonymity"/>
                                        <Button Content="🌐 Sources..." Click="OpenProxySources_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="12,8" ToolTip="Bulk add, edit, or customize proxy repository URLs &amp; APIs" AutomationProperties.Name="Bulk Add and Edit Proxy Repository Sources"/>
                                        <Button Content="💾 Export Working" Command="{Binding ExportWorkingProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="12,8" ToolTip="Export all verified healthy proxies to a text file (IP:PORT format)"/>
                                        <Button Content="📂 Import File" Command="{Binding ImportProxiesFileCommand}" Style="{StaticResource CyberButton}" Padding="12,8" ToolTip="Import custom proxy lists from a local text or CSV file"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Telemetry Metric Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total Harvested -->
                                <Border Grid.Column="0" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="0,0,8,0" ToolTip="Total unique proxy servers discovered and stored in local database">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL HARVESTED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TotalHarvestedCount}" FontSize="22" FontWeight="Black" Foreground="#00F0FF" Margin="0,4,0,0"/>
                                        <TextBlock Text="Candidates in database" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Verified Healthy -->
                                <Border Grid.Column="1" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,8,0" ToolTip="Number of healthy proxies that passed connectivity and anonymity validation">
                                    <StackPanel>
                                        <TextBlock Text="VERIFIED ACTIVE POOL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding VerifiedHealthyCount}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0"/>
                                        <TextBlock Text="Ready for instant rotation" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Average Latency -->
                                <Border Grid.Column="2" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,8,0" ToolTip="Average round-trip response time across all active validated proxies">
                                    <StackPanel>
                                        <TextBlock Text="AVERAGE POOL LATENCY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding AveragePingMs, StringFormat='{}{0} ms'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                        <TextBlock Text="Real-time RTT response" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Rotator Port & Status -->
                                <Border Grid.Column="3" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,0,0" ToolTip="Local proxy listener address (127.0.0.1:8081). Point browsers or scrapers here to route through rotating proxies">
                                    <StackPanel>
                                        <TextBlock Text="LISTENING ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding RotatingProxyPort, StringFormat='{}127.0.0.1:{0}'}" FontSize="18" FontWeight="Black" Foreground="#38BDF8" Margin="0,6,0,0" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding IsRotatingProxyRunning, Converter={StaticResource BoolToOnlineStatusConverter}}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Configuration & Strategy Controls -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Strategy Selector -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Strategy:" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding RotationStrategies}" SelectedItem="{Binding SelectedRotationStrategy}" Width="210" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Choose rotation strategy: Time-Based Interval (switches periodically), Round-Robin Per Request, Sticky Domain, Sticky Session, or Lowest Latency First"/>
                                    </StackPanel>

                                    <!-- Country Filter -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="🌍 Country:" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding CountryFilters}" SelectedItem="{Binding SelectedCountryFilter}" Width="85" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter rotation strictly to proxies in a specific country (e.g., US, DE, JP, or ALL)"/>
                                    </StackPanel>

                                    <!-- Status message / Progress -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding HarvestStatusText}" FontSize="11" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Value="{Binding HarvestProgress}" Maximum="100" Height="4" Margin="0,4,0,0" Background="#1E293B" Foreground="#00F0FF" Visibility="{Binding IsHarvestingOrValidating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Toggles: Multi-NIC Chaining, Strict Anonymity & Periodic Auto Timers -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding RouteBondedTrafficThroughRotator, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Combines network adapters first for aggregate throughput, then routes all outbound traffic through the selected rotating proxy server">
                                            <TextBlock Text="⚡ Bond-then-Rotate" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding AutoHarvestEnabled, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Background auto-harvest fresh proxies every 30 minutes in idempotence mode">
                                            <TextBlock Text="🔄 Auto-Harvest" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding AutoValidateEnabled, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Continuous background health checks and dead pruning every 5 minutes">
                                            <TextBlock Text="🩺 Auto-Check" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ChainPhysicalAdapters, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Dispatches outgoing proxy connections across all enabled physical adapters">
                                            <TextBlock Text="⚡ Multi-NIC" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding StrictAnonymity, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,12,0" ToolTip="Restricts rotation strictly to Elite and Anonymous proxies">
                                            <TextBlock Text="🛡 Elite Only" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <Button Content="🗑 Prune" Command="{Binding PruneDeadProxiesCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Remove all unresponsive, dead, and high-failure proxies from the database"/>
                                        <Button Content="✕ Clear" Command="{Binding ClearProxiesCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" ToolTip="Delete all harvested proxies from the database"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Harvested & Verified Proxy Pool DataGrid -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="LIVE HARVESTED PROXY POOL (Top Responsive Endpoints)" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Connect applications or scrapers to: http://127.0.0.1:8081" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Interactive Sorting & Multi-Faceted Filtering Bar -->
                                    <Border Background="{DynamicResource CyberCard}" CornerRadius="8" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Search, Latency, Source & Protocol -->
                                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <!-- Keyword Search -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Text="{Binding ProxySearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="26" Padding="6,2" FontSize="11" ToolTip="Search proxies by IP address, port number, country code, or repository source" AutomationProperties.Name="Filter Proxies Search Box"/>
                                                </StackPanel>

                                                <!-- Latency Filter -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="⚡ Ping:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ComboBox ItemsSource="{Binding LatencyFilters}" SelectedItem="{Binding SelectedLatencyFilter}" Width="145" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter visible proxies by maximum round-trip latency threshold (e.g. &lt;= 150ms, &lt;= 300ms)"/>
                                                </StackPanel>

                                                <!-- Source Filter -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="📁 Source:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSourceFilter}" Width="135" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter proxies harvested from a specific GitHub repository or API feed"/>
                                                </StackPanel>

                                                <!-- Protocol Filter -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="🔒 Proto:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ComboBox ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding SelectedProtocolFilter}" Width="110" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter proxies by supported protocol (HTTP, HTTPS, SOCKS4, SOCKS5)"/>
                                                </StackPanel>
                                            </WrapPanel>

                                            <!-- Row 1: Successes, Failures, Sort Option & Result Count Badge -->
                                            <Grid Grid.Row="1">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <!-- Success Filter -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="✓ Succ:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <ComboBox ItemsSource="{Binding SuccessFilters}" SelectedItem="{Binding SelectedSuccessFilter}" Width="135" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter proxies by minimum successful connection benchmark (e.g. ≥ 1, ≥ 5)"/>
                                                    </StackPanel>

                                                    <!-- Failure Filter -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="✕ Fail:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <ComboBox ItemsSource="{Binding FailureFilters}" SelectedItem="{Binding SelectedFailureFilter}" Width="135" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Filter proxies by maximum tolerated failure count (e.g. 0 Failures Perfect, ≤ 1, ≤ 3)"/>
                                                    </StackPanel>

                                                    <!-- Sort Option -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="⇅ Sort:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CyberCyan}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Width="165" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Sort the proxy list dynamically by Latency, Success Rate, Failures, Country, Protocol, or Endpoint"/>
                                                    </StackPanel>
                                                </WrapPanel>

                                                <!-- Filtered Count Badge -->
                                                <TextBlock Text="{Binding FilteredCountText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CyberCyan}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" ToolTip="Total proxies matching active search criteria and filters"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Proxy Selection & Timely Rotation Action Bar -->
                                    <Border Background="#0D1527" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Selection & Force Connect Buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="☑ SELECTION:" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="Select All" Command="{Binding SelectAllProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Select all proxies in view to participate in rotation"/>
                                                <Button Content="Deselect All" Command="{Binding DeselectAllProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Uncheck all proxies so none are flagged for rotation"/>
                                                <Button Content="Select Fast (≤300ms)" Command="{Binding SelectFastProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Automatically select all healthy proxies with response times under 300ms"/>
                                                <Button Content="⚡ Rotate Now" Command="{Binding ForceRotateCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Immediately rotate to the next proxy server in the pool, continuing to probe candidates until finding a live connection"/>
                                                <Button Content="🎯 Force Connect" Command="{Binding ForceConnectSelectedOrNextCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="8,4" FontSize="11" ToolTip="Forcefully connects immediately to the proxy selected in the table, or auto-probes and connects to the next live responsive proxy in the candidate pool"/>
                                            </StackPanel>

                                            <!-- Current Selection Summary & Countdown -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" ToolTip="Count of healthy proxies selected to participate in rotation">
                                                    <TextBlock Text="{Binding SelectedProxiesCountText}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                                </Border>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" ToolTip="Time remaining until the next automatic proxy server rotation">
                                                    <TextBlock Text="{Binding RotationCountdownText}" FontSize="11" FontFamily="Consolas" Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Interval Selector -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏱ Interval:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox ItemsSource="{Binding RotationIntervalOptions}" SelectedValue="{Binding RotationIntervalSeconds}" SelectedValuePath="Seconds" DisplayMemberPath="Label" Width="82" Height="26" FontSize="11" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center" ToolTip="Timed rotation interval (up to 2 hours): automatically switches to the next live proxy when expired"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataGrid ItemsSource="{Binding HarvestedProxies}" SelectedItem="{Binding SelectedProxyRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True" Height="360" Background="#080C14" BorderBrush="#1E293B" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0B1120" Foreground="#FFFFFF" HeadersVisibility="Column" ToolTip="Harvested and validated proxy servers. Select rows and click Connect or Rotate Now to dispatch traffic." AutomationProperties.Name="Harvested Proxies Table">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="USE" Width="45">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Check to include this proxy in the active rotation pool" AutomationProperties.Name="{Binding Endpoint, StringFormat='{}Select {0} for rotation'}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="ACTION" Width="75">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Connect" Command="{Binding DataContext.ForceConnectSelectedOrNextCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource CyberButton}" Padding="4,2" FontSize="10" ToolTip="Forcefully connect to this specific proxy server immediately"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="STATUS" Width="90" IsReadOnly="True" SortMemberPath="IsHealthy">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding StatusBadgeText}">
                                                             <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#040810"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="GEO" Binding="{Binding CountryCode}" Width="60" FontWeight="Bold" IsReadOnly="True" SortMemberPath="CountryCode"/>
                                            <DataGridTextColumn Header="ENDPOINT (HOST:PORT)" Binding="{Binding Endpoint}" Width="170" FontFamily="Consolas" IsReadOnly="True" SortMemberPath="Endpoint"/>
                                            <DataGridTextColumn Header="PROTOCOL" Binding="{Binding FormattedProtocol}" Width="90" IsReadOnly="True" SortMemberPath="Protocol"/>
                                            <DataGridTextColumn Header="ANONYMITY" Binding="{Binding FormattedAnonymity}" Width="105" IsReadOnly="True" SortMemberPath="Anonymity"/>
                                            <DataGridTextColumn Header="LATENCY" Binding="{Binding LatencyMs, StringFormat='{}{0}ms'}" Width="80" IsReadOnly="True" SortMemberPath="LatencyMs"/>
                                            <DataGridTextColumn Header="FAILURES" Binding="{Binding Failures}" Width="70" IsReadOnly="True" SortMemberPath="Failures"/>
                                            <DataGridTextColumn Header="SUCCESSES" Binding="{Binding Successes}" Width="80" IsReadOnly="True" SortMemberPath="Successes"/>
                                            <DataGridTextColumn Header="SOURCE REPOSITORY / URL" Binding="{Binding SourceUrl}" Width="*" IsReadOnly="True" SortMemberPath="SourceUrl"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Pinned Accessible Glass Footer Status Bar -->
            <Border Grid.Row="2" Background="#060910" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ COMBISPEED" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#38BDF8"/>
                        <Border Padding="6,1" CornerRadius="3" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" Margin="0,0,10,0" ToolTip="Current Version &amp; Build">
                            <TextBlock Text="{Binding AppVersionFull}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text="Multi-WAN Channel Bonding &amp; Bandwidth Aggregation Engine" FontSize="10" Foreground="#F1F5F9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Accessibility Status Pill -->
                        <Border Margin="0,0,12,0" Padding="6,1" CornerRadius="3" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" ToolTip="Active Accessibility Scale">
                            <TextBlock Text="{Binding UiScale, Converter={StaticResource ScaleToPercentStringConverter}, StringFormat='{}♿ Scale: {0}'}" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        </Border>

                        <TextBlock Text="{Binding AutoSaveStatusText, StringFormat='{}Auto-Sync: {0}'}" FontSize="10" Foreground="#34D399" Margin="0,0,16,0"/>
                        <TextBlock Text="Windows x64 (.NET 8.0)" FontSize="10" Foreground="#CBD5E1" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
