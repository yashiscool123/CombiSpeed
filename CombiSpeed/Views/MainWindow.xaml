<Window x:Class="CombiSpeed.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CombiSpeed.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="860" Width="1220"
        MinWidth="1060" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CyberBg}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{DynamicResource CyberBorder}"
        BorderThickness="1">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding TogglePowerCommand}"/>
        <KeyBinding Gesture="Alt+P" Command="{Binding TogglePowerCommand}"/>
        <KeyBinding Gesture="Alt+B" Command="{Binding ToggleVirtualBridgeCommand}"/>
        <KeyBinding Gesture="Alt+W" Command="{Binding ToggleWindowsProxyCommand}"/>
        <KeyBinding Gesture="Alt+R" Command="{Binding RefreshAdaptersCommand}"/>
        <KeyBinding Gesture="Alt+H" Command="{Binding ToggleHighContrastCommand}"/>
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Gesture="Ctrl+NumPad2" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Gesture="Ctrl+NumPad3" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Gesture="Ctrl+NumPad4" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Gesture="Ctrl+NumPad5" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
    </Window.InputBindings>

    <Border Background="{DynamicResource CyberBg}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1">
        <Grid>
            <!-- Accessible Dynamic UI Layout Transform -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </Grid.LayoutTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Custom Accessible TitleBar -->
            <Border Grid.Row="0" Background="#060910" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" CornerRadius="12,12,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Neon Brand Logo -->
                        <Border Width="26" Height="26" CornerRadius="7" Background="#00F0FF" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="15" Foreground="#040810" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="COMBISPEED" FontWeight="Black" FontSize="14" Foreground="#00F0FF" VerticalAlignment="Center"/>

                        <!-- Version Badge -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" VerticalAlignment="Center" ToolTip="Installed Release Version &amp; Build Code">
                            <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        </Border>
                        <Border Width="1" Height="14" Background="#1E293B" Margin="10,0"/>

                        <!-- Engine State Indicator with Icon & Accessible Color -->
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="DISCONNECTED"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Text" Value="BONDING ACTIVE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- System Proxy Tag -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                Visibility="{Binding IsWindowsProxyActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="🛡️ SYS PROXY ON" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>

                        <!-- Virtual Bridge Tag -->
                        <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#064E3B" BorderBrush="#10B981" BorderThickness="0.5"
                                Visibility="{Binding VirtualBridge.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="🌉 BRIDGE BONDED" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>

                        <!-- High Contrast Tag -->
                        <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#1E293B" BorderBrush="#00F0FF" BorderThickness="0.5"
                                Visibility="{Binding IsHighContrast, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="♿ HC: ON" FontSize="9" FontWeight="Bold" Foreground="#00F0FF"/>
                        </Border>
                    </StackPanel>

                    <!-- TitleBar Action Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Quick Accessibility Button -->
                        <Button Click="OpenAccessibility_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="10,4" FontSize="11" ToolTip="Accessibility Options &amp; Shortcuts (Alt+A)" AutomationProperties.Name="Open Accessibility Options">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♿" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Accessibility" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Content="⚙" Click="OpenSettings_Click" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Padding="8,4" FontSize="12" ToolTip="Configuration Settings (Alt+S)" AutomationProperties.Name="Open Settings"/>

                        <!-- Window Control Buttons -->
                        <Button Content="—" Width="30" Height="26" Click="MinimizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0" AutomationProperties.Name="Minimize Window"/>
                        <Button Content="▢" Width="30" Height="26" Click="MaximizeButton_Click" Style="{StaticResource CyberButton}" Padding="0" Margin="0,0,4,0" AutomationProperties.Name="Maximize Window"/>
                        <Button Content="✕" Width="30" Height="26" Click="CloseButton_Click" Style="{StaticResource CyberButton}" Padding="0" AutomationProperties.Name="Close Window"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Native TabControl with Custom Segmented Navigation Style -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Style="{StaticResource SegmentedTabControl}">
                <!-- ========================================== -->
                <!-- TAB 0: OVERVIEW & DASHBOARD                -->
                <!-- ========================================== -->
                <TabItem Header="⚡ Overview &amp; Dashboard" Style="{StaticResource SegmentedTabItem}" AutomationProperties.Name="Overview and Dashboard Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Master Hero Control Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big Power Switch -->
                                    <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Width="78" Height="78" Margin="0,0,22,0" Cursor="Hand" ToolTip="Toggle Master Multi-WAN Bonding (Space / Alt+P)" AutomationProperties.Name="Master Bonding Power Button">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                                <TextBlock x:Name="btnIcon" Text="⏻" FontSize="36" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#00F0FF"/>
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter TargetName="btnIcon" Property="Foreground" Value="#040810"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00F0FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Status Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="MULTI-WAN CHANNEL BONDING ENGINE" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{Binding Config.RoutingMode, StringFormat='{}Mode: {0}'}" FontSize="10" Foreground="#CBD5E1" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aggregation Engine Idle"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                            <Setter Property="Text" Value="Bandwidth Aggregation Active"/>
                                                            <Setter Property="Foreground" Value="#00F0FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Multiplexes concurrent TCP &amp; UDP connections across all enabled physical interfaces into a unified super-pipe." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Hero Action Bar -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Windows System Proxy Toggle -->
                                        <Button Command="{Binding ToggleWindowsProxyCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" AutomationProperties.Name="Toggle Windows System Proxy">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🛡" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding IsWindowsProxyActive, StringFormat='{}Win Proxy: {0}'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Win Proxy: OFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWindowsProxyActive}" Value="True">
                                                                    <Setter Property="Text" Value="Win Proxy: ON"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Virtual Bridge Toggle -->
                                        <Button Command="{Binding ToggleVirtualBridgeCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" AutomationProperties.Name="Toggle Virtual Bonded Bridge">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌉" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding VirtualBridge.IsConnected, StringFormat='{}Bridge: {0}'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Bridge: OFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VirtualBridge.IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="Bridge: ON"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <Button Content="📊 Benchmark Speed" Click="OpenSpeedTest_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" AutomationProperties.Name="Open Speed Benchmark"/>
                                        <Button Content="⟳" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource CyberButton}" ToolTip="Rescan Network Adapters (Alt+R)" AutomationProperties.Name="Rescan Adapters"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Telemetry 4-Card Grid (High-Contrast Large Typography) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed Card -->
                                <Border Grid.Column="0" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="BONDED DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding BondedDownloadSpeed}" FontSize="26" FontWeight="Black" Foreground="#00F0FF" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="Real-time aggregated bandwidth" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Upload Speed Card -->
                                <Border Grid.Column="2" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="BONDED UPLOAD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding BondedUploadSpeed}" FontSize="26" FontWeight="Black" Foreground="#8B5CF6" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="Outbound throughput across NICs" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Concurrency Card -->
                                <Border Grid.Column="4" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE CONCURRENCY" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ActiveStreamsCount}" FontSize="26" FontWeight="Black" Foreground="#10B981" FontFamily="Consolas"/>
                                            <TextBlock Text=" streams" FontSize="13" Foreground="#F1F5F9" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalStreamsCount, StringFormat='{}Total Dispatched: {0}'}" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Volume & Uptime Card -->
                                <Border Grid.Column="6" Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="SESSION VOLUME &amp; UPTIME" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding SessionVolume}" FontSize="26" FontWeight="Black" Foreground="#F59E0B" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Uptime, StringFormat='{}Uptime: {0}'}" FontSize="11" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Virtual Bonded Bridge Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,10,0">
                                                <TextBlock Text="🌉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="VIRTUAL BONDED BRIDGE &amp; ADAPTER CONNECTION" FontSize="12" FontWeight="Black" Foreground="#00F0FF"/>
                                                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" Background="{Binding VirtualBridge.StatusBrush}">
                                                        <TextBlock Text="{Binding VirtualBridge.StatusText}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Native Windows virtual adapter merging physical NICs based on user % allocation." FontSize="11" Foreground="#F1F5F9" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="View in Windows (ncpa.cpl)" Command="{Binding OpenNetworkConnectionsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" AutomationProperties.Name="Open Network Connections in Windows"/>
                                            <Button Content="⟳ Re-provision" Command="{Binding ReprovisionBridgeCommand}" Style="{StaticResource CyberButton}" AutomationProperties.Name="Reprovision Virtual Bridge"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Metadata Strip -->
                                    <Border Background="#080C14" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="WINDOWS CONNECTION NAME" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.ConnectionName}" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="VIRTUAL IP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.VirtualIp}" FontSize="13" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="GATEWAY" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.GatewayIp}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="BRIDGE THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding VirtualBridge.FormattedDownloadSpeed, StringFormat='{}↓ {0}'}" FontSize="13" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Segmented Distribution Bar -->
                                    <Border Background="{DynamicResource CyberCard}" CornerRadius="10" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="MERGED PHYSICAL ADAPTERS &amp; BANDWIDTH ALLOCATION %" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                                                <TextBlock Text="{Binding VirtualBridge.MergedAdaptersSummary}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                            </Grid>

                                            <Border Height="14" CornerRadius="6" Background="#080C14" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding Adapters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Height="14" Width="{Binding EffectivePercentageWidth}" Fill="{Binding AccentHexColor}" ToolTip="{Binding FormattedEffectivePercentage}" Margin="0,0,2,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Real-Time Bandwidth Waveform -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="REAL-TIME BANDWIDTH WAVEFORM" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text=" (Last 60 Seconds)" FontSize="11" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="8" Height="8" Fill="#00F0FF" Margin="0,0,4,0"/>
                                            <TextBlock Text="Download" FontSize="11" Foreground="#F1F5F9" Margin="0,0,12,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,4,0"/>
                                            <TextBlock Text="Upload" FontSize="11" Foreground="#F1F5F9" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding PeakSpeedFormatted}" FontSize="11" Foreground="#00F0FF" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#080C14" CornerRadius="10" Height="140" ClipToBounds="True">
                                        <Grid>
                                            <Polyline Points="{Binding WaveformPointsDownload}" Stroke="#00F0FF" StrokeThickness="2"/>
                                            <Polyline Points="{Binding WaveformPointsUpload}" Stroke="#8B5CF6" StrokeThickness="1.5"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 1: COMBINED ADAPTERS & ALLOCATION      -->
                <!-- ========================================== -->
                <TabItem Header="🖧 Combined Adapters" Style="{StaticResource SegmentedTabItem}" AutomationProperties.Name="Combined Adapters Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Profiles Header Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="14" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="COMBINATION PROFILES &amp; ADAPTER ALLOCATION" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Profile:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding ActiveProfileName}" Width="200" Height="32" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="Active Combination Profile Selector"/>
                                        <Button Content="💾 Save" Command="{Binding SaveCurrentSettingsCommand}" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Persist current adapter combination &amp; weights" AutomationProperties.Name="Save Combination Settings"/>
                                        <Button Content="+ New Profile" Click="NewProfile_Click" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Save current settings under a new profile name" AutomationProperties.Name="Create New Profile"/>
                                        <Button Content="✕" Command="{Binding DeleteProfileCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" ToolTip="Delete selected profile" AutomationProperties.Name="Delete Active Profile"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Adapters Grid (2-Column Responsive Card Grid) -->
                            <ItemsControl ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CyberSurface}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="6">
                                            <StackPanel>
                                                <!-- Top: Name, Status, Toggle -->
                                                <Grid Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" Height="28" Background="{Binding AccentHexColor}" CornerRadius="2" Margin="0,0,10,0"/>
                                                        <TextBlock Text="🖧" FontSize="18" Foreground="{Binding AccentHexColor}" Margin="0,0,8,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#F1F5F9" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="#080C14" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding PingMs, StringFormat='{}{0} ms'}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding PingMs, Converter={StaticResource PingToBrushConverter}}"/>
                                                        </Border>
                                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='{}Enable {0}'}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- IP & MAC -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="BOUND LOCAL IP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding Address}" FontSize="12" FontFamily="Consolas" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PUBLIC WAN IP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding WanIp}" FontSize="12" FontFamily="Consolas" Foreground="#00F0FF"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Live Speeds -->
                                                <Border Background="#080C14" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="↓ " Foreground="#00F0FF" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding FormattedDownloadSpeed}" FontSize="13" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="↑ " Foreground="#8B5CF6" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding FormattedUploadSpeed}" FontSize="13" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Weight Ratio Slider & Effective Utilization % -->
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="BANDWIDTH SHARE: " FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding FormattedEffectivePercentage}" FontSize="11" FontWeight="Bold" Foreground="{Binding AccentHexColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormattedThrottledBandwidth}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,8,0" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding Weight, StringFormat='{}Weight: {0}%'}" FontSize="11" Foreground="#F1F5F9" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Weight}" SmallChange="5" LargeChange="10" Margin="0,4,0,0" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding Name, StringFormat='{}Bandwidth Weight for {0}'}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 2: SPEED SHAPER & QOS                  -->
                <!-- ========================================== -->
                <TabItem Header="🚀 Speed Shaper &amp; QoS" Style="{StaticResource SegmentedTabItem}" AutomationProperties.Name="Speed Shaper and QoS Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Speed Shaper Banner -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="⚡ DYNAMIC SPEED SHAPER &amp; QOS CONTROL" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#131D33" CornerRadius="4" Padding="6,2" BorderBrush="#00F0FF" BorderThickness="0.5">
                                                <TextBlock Text="{Binding ThrottleStatusText}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Actively shapes packet flows, adjusts Token Bucket capacities in real time as link telemetry fluctuates, and eliminates bufferbloat for gaming &amp; streaming." FontSize="12" Foreground="#F1F5F9" Margin="0,0,0,12"/>

                                        <!-- Mode Selector Grid -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Optimization Mode:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ShaperModes}" SelectedItem="{Binding SelectedShaperMode}" Height="34" FontSize="11" AutomationProperties.Name="Speed Shaper Optimization Mode"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Global Bandwidth Cap:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ThrottlePresets}" SelectedItem="{Binding SelectedThrottlePreset}" Height="34" FontSize="11" AutomationProperties.Name="Global Speed Throttle Cap Preset"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Actions -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⚙ Custom Throttling Parameters (Mbps / Burst / Per-NIC)..." Click="CustomThrottle_Click" Style="{StaticResource PrimaryCyanButton}" Margin="0,0,10,0" AutomationProperties.Name="Open Custom Throttling Dialog"/>
                                            <CheckBox IsChecked="{Binding Config.EnableDynamicShaping}" Content="Enable Real-Time Dynamic Adaptation across connections" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Enable Dynamic Adaptation"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- QoS Mode Feature Comparison Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="SPEED SHAPER OPTIMIZATION OBJECTIVES" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Max Bandwidth Mode Box -->
                                        <Border Grid.Column="0" Background="#080C14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="🚀 MAXIMUM BANDWIDTH MODE" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Large Token Bucket burst buffers (150ms-250ms) for full TCP window expansion." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Dynamic cross-connection borrowing: surging streams borrow unused capacity." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Throughput-weighted dispatching prioritizing high-capacity lines." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Lowest Latency Mode Box -->
                                        <Border Grid.Column="2" Background="#080C14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="⚡ LOWEST LATENCY / PING MODE" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Anti-bufferbloat pacing (clamped to 20ms burst window) eliminates queue latency." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Inverse-ping token weighting (1000 / PingMs) funnels packets to fastest line." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                                <TextBlock Text="• Optimized for Valorant, CS2, CoD, Discord voice &amp; WebRTC calls." FontSize="11" Foreground="#F1F5F9" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 3: CONNECTION AUDIT                    -->
                <!-- ========================================== -->
                <TabItem Header="📜 Connection Audit" Style="{StaticResource SegmentedTabItem}" AutomationProperties.Name="Connection Audit Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="CONNECTION AUDIT STREAM" FontSize="12" FontWeight="Bold" Foreground="#00F0FF"/>
                                            <TextBlock Text=" (Live Network Requests &amp; Physical NIC Routing)" FontSize="11" Foreground="#CBD5E1" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" Style="{StaticResource CyberButton}" HorizontalAlignment="Right" Padding="12,4" FontSize="11" AutomationProperties.Name="Clear Connection Audit Logs"/>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Height="480" Background="#080C14" BorderBrush="#1E293B" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0B1120" Foreground="#FFFFFF" HeadersVisibility="Column" AutomationProperties.Name="Connection Audit Logs Table">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="80"/>
                                            <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="95"/>
                                            <DataGridTextColumn Header="TARGET DESTINATION" Binding="{Binding DestinationFormatted}" Width="*"/>
                                            <DataGridTextColumn Header="DISPATCHED ADAPTER" Binding="{Binding AdapterName}" Width="180"/>
                                            <DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeFormatted}" Width="90"/>
                                            <DataGridTextColumn Header="DURATION" Binding="{Binding DurationMs, StringFormat='{}{0}ms'}" Width="90"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 4: ROTATING PROXY & HARVESTER          -->
                <!-- ========================================== -->
                <TabItem Header="🔄 Rotating Proxy &amp; Harvester" Style="{StaticResource SegmentedTabItem}" AutomationProperties.Name="Rotating Proxy and Harvester Tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Rotating Proxy Hero Card -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="AUTOMATED ROTATING PROXY HARVESTER &amp; DISPATCHER" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{Binding RotatingProxyPort, StringFormat='{}Port: {0}'}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Double-Layer Multi-NIC Egress &amp; Open-Source Harvester" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Harvests live proxies from curated open-source feeds &amp; custom URLs, validates health &amp; anonymity, and rotates upstream requests across local physical network adapters." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding IsRotatingProxyRunning, Converter={StaticResource BoolToRotatorStatusConverter}}" Command="{Binding ToggleRotatingProxyCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,8" FontWeight="Bold"/>
                                        <Button Content="⚡ Harvest Proxies" Command="{Binding HarvestProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,8" FontWeight="Bold"/>
                                        <Button Content="🔍 Validate Pool" Command="{Binding ValidatePoolCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="12,8"/>
                                        <Button Content="💾 Export Working" Command="{Binding ExportWorkingProxiesCommand}" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="12,8"/>
                                        <Button Content="📂 Import File" Command="{Binding ImportProxiesFileCommand}" Style="{StaticResource CyberButton}" Padding="12,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Telemetry Metric Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total Harvested -->
                                <Border Grid.Column="0" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL HARVESTED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TotalHarvestedCount}" FontSize="22" FontWeight="Black" Foreground="#00F0FF" Margin="0,4,0,0"/>
                                        <TextBlock Text="Candidates in database" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Verified Healthy -->
                                <Border Grid.Column="1" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="VERIFIED ACTIVE POOL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding VerifiedHealthyCount}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0"/>
                                        <TextBlock Text="Ready for instant rotation" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Average Latency -->
                                <Border Grid.Column="2" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="AVERAGE POOL LATENCY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding AveragePingMs, StringFormat='{}{0} ms'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                        <TextBlock Text="Real-time RTT response" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Rotator Port & Status -->
                                <Border Grid.Column="3" Background="{DynamicResource CyberCard}" CornerRadius="12" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="14" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LISTENING ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding RotatingProxyPort, StringFormat='{}127.0.0.1:{0}'}" FontSize="18" FontWeight="Black" Foreground="#38BDF8" Margin="0,6,0,0" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding IsRotatingProxyRunning, Converter={StaticResource BoolToOnlineStatusConverter}}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Configuration & Strategy Controls -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Strategy Selector -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Strategy:" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding RotationStrategies}" SelectedItem="{Binding SelectedRotationStrategy}" Width="210" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Country Filter -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="🌍 Country:" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding CountryFilters}" SelectedItem="{Binding SelectedCountryFilter}" Width="85" Style="{StaticResource CyberComboBox}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Status message / Progress -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding HarvestStatusText}" FontSize="11" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Value="{Binding HarvestProgress}" Maximum="100" Height="4" Margin="0,4,0,0" Background="#1E293B" Foreground="#00F0FF" Visibility="{Binding IsHarvestingOrValidating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Toggles: Multi-NIC Chaining, Strict Anonymity & Periodic Auto Timers -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding AutoHarvestEnabled, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Background auto-harvest fresh proxies every 30 minutes">
                                            <TextBlock Text="🔄 Auto-Harvest" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding AutoValidateEnabled, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Continuous background health checks and dead pruning every 5 minutes">
                                            <TextBlock Text="🩺 Auto-Check" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ChainPhysicalAdapters, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,10,0" ToolTip="Dispatches outgoing proxy connections across all enabled physical adapters">
                                            <TextBlock Text="⚡ Multi-NIC" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding StrictAnonymity, Mode=TwoWay}" Style="{StaticResource CyberCheckBox}" Margin="0,0,12,0" ToolTip="Restricts rotation strictly to Elite and Anonymous proxies">
                                            <TextBlock Text="🛡 Elite Only" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                        </CheckBox>
                                        <Button Content="🗑 Prune" Command="{Binding PruneDeadProxiesCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="✕ Clear" Command="{Binding ClearProxiesCommand}" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Harvested & Verified Proxy Pool DataGrid -->
                            <Border Background="{DynamicResource CyberSurface}" CornerRadius="16" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="LIVE HARVESTED PROXY POOL (Top Responsive Endpoints)" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Connect applications or scrapers to: http://127.0.0.1:8081" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding HarvestedProxies}" AutoGenerateColumns="False" IsReadOnly="True" Height="360" Background="#080C14" BorderBrush="#1E293B" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0B1120" Foreground="#FFFFFF" HeadersVisibility="Column" AutomationProperties.Name="Harvested Proxies Table">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#040810"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="GEO" Binding="{Binding CountryCode}" Width="60" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="ENDPOINT (HOST:PORT)" Binding="{Binding Endpoint}" Width="170" FontFamily="Consolas"/>
                                            <DataGridTextColumn Header="PROTOCOL" Binding="{Binding FormattedProtocol}" Width="90"/>
                                            <DataGridTextColumn Header="ANONYMITY" Binding="{Binding FormattedAnonymity}" Width="105"/>
                                            <DataGridTextColumn Header="LATENCY" Binding="{Binding LatencyMs, StringFormat='{}{0}ms'}" Width="80"/>
                                            <DataGridTextColumn Header="FAILURES" Binding="{Binding Failures}" Width="70"/>
                                            <DataGridTextColumn Header="SUCCESSES" Binding="{Binding Successes}" Width="80"/>
                                            <DataGridTextColumn Header="SOURCE REPOSITORY / URL" Binding="{Binding SourceUrl}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Pinned Accessible Glass Footer Status Bar -->
            <Border Grid.Row="2" Background="#060910" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ COMBISPEED" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#38BDF8"/>
                        <Border Padding="6,1" CornerRadius="3" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" Margin="0,0,10,0" ToolTip="Current Version &amp; Build">
                            <TextBlock Text="{Binding AppVersionFull}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text="Multi-WAN Channel Bonding &amp; Bandwidth Aggregation Engine" FontSize="10" Foreground="#F1F5F9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Accessibility Status Pill -->
                        <Border Margin="0,0,12,0" Padding="6,1" CornerRadius="3" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="0.5" ToolTip="Active Accessibility Scale">
                            <TextBlock Text="{Binding UiScale, Converter={StaticResource ScaleToPercentStringConverter}, StringFormat='{}♿ Scale: {0}'}" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                        </Border>

                        <TextBlock Text="{Binding AutoSaveStatusText, StringFormat='{}Auto-Sync: {0}'}" FontSize="10" Foreground="#34D399" Margin="0,0,16,0"/>
                        <TextBlock Text="Windows x64 (.NET 8.0)" FontSize="10" Foreground="#CBD5E1" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
