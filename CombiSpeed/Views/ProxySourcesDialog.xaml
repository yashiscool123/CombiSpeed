<Window x:Class="CombiSpeed.Views.ProxySourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Repository Sources &amp; URLs"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#00F0FF"
        BorderThickness="1"
        MouseDown="Window_MouseDown">
    <Border Background="#0B1120" CornerRadius="16" BorderBrush="#00F0FF" BorderThickness="1" Margin="2">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Proxy Repository Sources &amp; URLs" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Bulk add, edit, or customize proxy feed URLs, raw GitHub lists &amp; JSON APIs" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="CancelButton_Click" Style="{StaticResource CyberButton}" Padding="0" AutomationProperties.Name="Close Proxy Sources Dialog"/>
            </Grid>

            <!-- Guidelines & Real-Time Stats -->
            <Border Grid.Row="1" Background="#080C14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BULK URL CONFIGURATION RULES" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,4"/>
                        <TextBlock Text="• Enter one valid HTTP/HTTPS URL per line (raw text, CSV, JSON APIs, or HTML tables)." FontSize="11" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                        <TextBlock Text="• Lines starting with # or // are treated as comments and ignored." FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <Border Background="#131D33" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1" Padding="12,6">
                            <TextBlock x:Name="TxtUrlCount" Text="Total URLs: 0" FontSize="11" FontWeight="Bold" Foreground="#00F0FF"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bulk Multi-Line Text Editor -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Border Background="#080C14" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="6">
                    <TextBox x:Name="TxtSources"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="#FFFFFF"
                             Background="#080C14"
                             BorderThickness="0"
                             Padding="8"
                             TextChanged="TxtSources_TextChanged"
                             AutomationProperties.Name="Bulk Proxy Sources Editor"/>
                </Border>
            </Grid>

            <!-- Bottom Action Toolbar & Save/Cancel Controls -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Edit Helpers -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↺ Reset to Defaults" Click="ResetDefaults_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="10,6" FontSize="11" ToolTip="Restore official verified open-source proxy repositories"/>
                    <Button Content="📋 Paste Clipboard" Click="PasteClipboard_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="10,6" FontSize="11" ToolTip="Append clipboard text to the editor"/>
                    <Button Content="🧹 Clear" Click="Clear_Click" Style="{StaticResource CyberButton}" Padding="8,6" FontSize="11" ToolTip="Clear all sources"/>
                </StackPanel>

                <!-- Status Feedback -->
                <TextBlock x:Name="TxtFeedback" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                <!-- Save & Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✕ Cancel" Click="CancelButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,6" FontSize="11"/>
                    <Button Content="💾 Save Sources" Click="SaveButton_Click" Style="{StaticResource PrimaryCyanButton}" Padding="16,6" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
