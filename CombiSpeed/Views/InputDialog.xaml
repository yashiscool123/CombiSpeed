<Window x:Class="CombiSpeed.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Combination Profile"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="230" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E293B"
        BorderThickness="1">
    <Border Background="#0B1120" CornerRadius="14" BorderBrush="#00F0FF" BorderThickness="1" Margin="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="28" Height="28" CornerRadius="6" Background="#131D33" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,10,0">
                    <TextBlock Text="💾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00F0FF"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Save Combination Profile" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Enter a name for this adapter &amp; bandwidth combination" FontSize="11" Foreground="#CBD5E1"/>
                </StackPanel>
            </StackPanel>

            <!-- Input Field -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPrompt" Text="Profile Name:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtInput" Text="My Combination" Background="#080C14" Foreground="#00F0FF" BorderBrush="#334155" Padding="10,6" FontSize="12" FontFamily="Consolas" AutomationProperties.Name="Profile Name Input"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,4" AutomationProperties.Name="Cancel Profile Creation"/>
                <Button Content="Save Profile" Click="OkButton_Click" Style="{StaticResource PrimaryCyanButton}" Padding="16,4" AutomationProperties.Name="Confirm Save Profile"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
